# Server-side only. Never expose this value in browser code.
ARK_API_KEY=
# Multimodal model that reads the uploaded photo and compiles the selected Skill.
ARK_SKILL_MODEL=doubao-seed-2-0-lite-260428
# Preferred order: default, backup, final fallback.
ARK_IMAGE_MODELS=doubao-seedream-4-5-251128,doubao-seedream-4-0-250828,doubao-seedream-5-0-lite-260128
# Gathered Scenes benefits from 4.0's stronger tactile print treatment; other scenes keep the global order above.
ARK_GATHERED_IMAGE_MODELS=doubao-seedream-4-0-250828,doubao-seedream-4-5-251128,doubao-seedream-5-0-lite-260128
# Comma-separated reusable invitation codes. Keep real codes out of Git.
GENERATION_ACCESS_CODES=
# Volcengine OpenAPI AK/SK for EntitySegment. These are different from ARK_API_KEY.
# Keep them server-side and configure the same values in veFaaS environment variables.
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
VOLC_CV_ENDPOINT=visual.volcengineapi.com
VOLC_CV_REGION=cn-north-1
